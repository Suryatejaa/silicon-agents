# LLM providers
SA_LLM_PRIMARY=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Server
SA_HOST=0.0.0.0
SA_PORT=8000
SA_API_KEY=local-dev-key
SA_LOG_LEVEL=INFO
PILOT_ACCESS_TOKEN=
SA_PILOT_COOKIE_NAME=sa_pilot_access

# Storage
DATABASE_URL=
SA_DB_PATH=./silicon_agents.db

# Agent limits
SA_MAX_REPORT_CHARS=50000
SA_MAX_CSV_CHARS=100000
SA_MAX_DECISIONS=20
SA_STREAM_TIMEOUT_S=120

# ATE binning boundaries
SA_BIN1_MIN_FREQ_GHZ=3.75
SA_BIN1_MAX_LEAKAGE_UA=200
SA_BIN2_MIN_FREQ_GHZ=3.0
SA_BIN3_MIN_FREQ_GHZ=2.0
